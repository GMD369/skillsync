PORT=5000
CLIENT_URL=http://localhost:3000
# Local MongoDB, or a MongoDB Atlas connection string for deployment
MONGO_URI=mongodb://127.0.0.1:27017/skillsync
# Use a long random string, e.g. generated with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
# Folder for uploaded resumes (default: uploads/resumes, ignored by Git)
# UPLOAD_DIR=uploads/resumes
# Separate database used only by automated tests (wiped by the tests)
TEST_MONGO_URI=mongodb://127.0.0.1:27017/skillsync_test
